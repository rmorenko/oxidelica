model ThreeBody "Figure-eight three-body choreography with tunable collision handling"
  parameter Real G = 1.0 "gravitational constant";
  parameter Real m1 = 1.0 "mass of body 1";
  parameter Real m2 = 1.0 "mass of body 2";
  parameter Real m3 = 1.0 "mass of body 3";
  parameter Real kc = 0.0 "contact stiffness: bodies bounce when > 0";
  parameter Real dc = 0.1 "contact distance for the bounce";
  parameter Real dstop = 0.0 "terminate when a pair is closer than this (0 = never)";
  Real x1(start = -0.97000436) "body 1 x";
  Real y1(start = 0.24308753) "body 1 y";
  Real x2(start = 0.97000436) "body 2 x";
  Real y2(start = -0.24308753) "body 2 y";
  Real x3(start = 0.0) "body 3 x";
  Real y3(start = 0.0) "body 3 y";
  Real vx1(start = 0.4662036850);
  Real vy1(start = 0.4323657300);
  Real vx2(start = 0.4662036850);
  Real vy2(start = 0.4323657300);
  Real vx3(start = -0.9324073700);
  Real vy3(start = -0.8647314600);
  Real d12 "distance between bodies 1 and 2";
  Real d13 "distance between bodies 1 and 3";
  Real d23 "distance between bodies 2 and 3";
  Real r12 "cubed distance 1-2";
  Real r13 "cubed distance 1-3";
  Real r23 "cubed distance 2-3";
  Real fx12 "contact force on body 1 from body 2, x";
  Real fy12 "contact force on body 1 from body 2, y";
  Real fx13 "contact force on body 1 from body 3, x";
  Real fy13 "contact force on body 1 from body 3, y";
  Real fx23 "contact force on body 2 from body 3, x";
  Real fy23 "contact force on body 2 from body 3, y";
equation
  d12 = sqrt((x2 - x1) ^ 2 + (y2 - y1) ^ 2);
  d13 = sqrt((x3 - x1) ^ 2 + (y3 - y1) ^ 2);
  d23 = sqrt((x3 - x2) ^ 2 + (y3 - y2) ^ 2);
  r12 = d12 ^ 3;
  r13 = d13 ^ 3;
  r23 = d23 ^ 3;
  fx12 = if d12 < dc then kc * (dc - d12) * (x1 - x2) / d12 else 0;
  fy12 = if d12 < dc then kc * (dc - d12) * (y1 - y2) / d12 else 0;
  fx13 = if d13 < dc then kc * (dc - d13) * (x1 - x3) / d13 else 0;
  fy13 = if d13 < dc then kc * (dc - d13) * (y1 - y3) / d13 else 0;
  fx23 = if d23 < dc then kc * (dc - d23) * (x2 - x3) / d23 else 0;
  fy23 = if d23 < dc then kc * (dc - d23) * (y2 - y3) / d23 else 0;
  der(x1) = vx1;
  der(y1) = vy1;
  der(x2) = vx2;
  der(y2) = vy2;
  der(x3) = vx3;
  der(y3) = vy3;
  der(vx1) = G * m2 * (x2 - x1) / r12 + G * m3 * (x3 - x1) / r13 + (fx12 + fx13) / m1;
  der(vy1) = G * m2 * (y2 - y1) / r12 + G * m3 * (y3 - y1) / r13 + (fy12 + fy13) / m1;
  der(vx2) = G * m1 * (x1 - x2) / r12 + G * m3 * (x3 - x2) / r23 + (-fx12 + fx23) / m2;
  der(vy2) = G * m1 * (y1 - y2) / r12 + G * m3 * (y3 - y2) / r23 + (-fy12 + fy23) / m2;
  der(vx3) = G * m1 * (x1 - x3) / r13 + G * m2 * (x2 - x3) / r23 + (-fx13 - fx23) / m3;
  der(vy3) = G * m1 * (y1 - y3) / r13 + G * m2 * (y2 - y3) / r23 + (-fy13 - fy23) / m3;
  when d12 < dstop or d13 < dstop or d23 < dstop then
    terminate("collision: two bodies came closer than dstop");
  end when;
  annotation(experiment(StopTime = 12.6518, Interval = 0.001, Tolerance = 1e-9));
end ThreeBody;
